<IfModule mod_rewrite.c>
    RewriteEngine On

    # Không rewrite thư mục admin
    RewriteCond %{REQUEST_URI} !^/GiupViecNhanh/admin/

    # Không rewrite file thật
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Chỉ redirect các request khác vào public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
